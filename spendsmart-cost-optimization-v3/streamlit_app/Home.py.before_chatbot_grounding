# ============================================================
# API HELPERS
# ============================================================

def api_get(
    path,
    default=None,
    timeout=30,
):
    try:
        response = requests.get(
            API + path,
            timeout=timeout,
        )
        response.raise_for_status()
        return response.json()

    except Exception:
        return default


def api_post(
    path,
    timeout=300,
):
    response = requests.post(
        API + path,
        timeout=timeout,
    )
    response.raise_for_status()
    return response.json()


