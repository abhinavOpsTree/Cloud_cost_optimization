                    {
                        "role": "system",
                        "content": (
                            system_prompt
                            + "\n\nFINOPS CONTEXT:\n"
                            + json.dumps(
                                chatbot_context,
                                default=str,
                            )
                        ),
                    }
                ]

                # Keep recent conversation for follow-up questions.
                messages.extend(
                    st.session_state.finops_messages[
                        -10:
                    ]
                )

                response = (
                    client
                    .chat.completions
                    .create(
                        model=(
                            settings.llm_model
                        ),
                        messages=messages,
                        temperature=0.1,
                    )
                )

                answer = (
                    response
                    .choices[0]
                    .message
                    .content
                    or ""
                )

                with st.chat_message(
                    "assistant"
                ):

                    st.markdown(
                        answer
                    )

                st.session_state.finops_messages.append(
                    {
                        "role": "assistant",
                        "content": answer,
                    }
                )

            except Exception as exc:

                error_message = (
                    "Unable to generate the FinOps "
                    f"assistant response: {exc}"
                )

                with st.chat_message(
                    "assistant"
                ):

                    st.error(
                        error_message
                    )

                st.session_state.finops_messages.append(
                    {
                        "role": "assistant",
                        "content": error_message,
                    }
                )


