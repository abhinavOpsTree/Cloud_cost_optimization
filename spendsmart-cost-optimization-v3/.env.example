SPENDSMART_VERIFY_SSL=true
SPENDSMART_TIMEOUT_SECONDS=30

RAW_DATA_DIR=./data/raw/spendsmart

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
