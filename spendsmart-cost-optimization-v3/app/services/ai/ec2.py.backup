from __future__ import annotations

import json
from typing import Any

from pydantic import BaseModel, ConfigDict, Field, ValidationError
from sqlalchemy.orm import Session

from app.core.config import settings
from app.core.logger import get_logger
from app.models import AISummary, OptimizationFinding
from app.services.analytics.ec2 import (
    summary,
    top_cost,
)


logger = get_logger("ai.ec2")


# ============================================================
# EXISTING EXECUTIVE SUMMARY
# ============================================================

def generate_summary(
    db: Session,
):
    """
    Generate the existing database-backed EC2 executive summary.

    This function is preserved for the existing
    /api/ai/ec2-summary functionality.
    """

    context = {
        "source": "SpendSmart / UnitEconPro",
        "service": "EC2",
        "summary": summary(db),
        "top_cost_instances": top_cost(
            db,
            15,
        ),
        "local_findings": [
            {
                "resource_id": x.resource_id,
                "finding_type": x.finding_type,
                "title": x.title,
                "severity": x.severity,
                "estimated_monthly_savings": (
                    x.estimated_monthly_savings
                ),
                "evidence": x.evidence,
            }
            for x in (
                db.query(
                    OptimizationFinding
                )
                .filter(
                    OptimizationFinding.service
                    == "EC2",
                    OptimizationFinding.status
                    == "open",
                )
                .limit(15)
                .all()
            )
        ],
    }

    if not settings.enable_llm:

        content = (
            "LLM is disabled. "
            "Set ENABLE_LLM=true and configure "
            "GROQ_API_KEY."
        )

        provider = "disabled"

    else:

        if not settings.groq_api_key:
            raise ValueError(
                "GROQ_API_KEY is not configured"
            )

        from groq import Groq

        client = Groq(
            api_key=(
                settings.groq_api_key.strip()
            )
        )

        response = (
            client.chat.completions.create(
                model=settings.llm_model,
                temperature=0.2,
                messages=[
                    {
                        "role": "system",
                        "content": (
                            "You are the SpendSmart "
                            "EC2 FinOps assistant. "
                            "Use only the supplied "
                            "evidence for account-specific "
                            "claims. Do not invent cost, "
                            "utilization, savings, "
                            "resources, or recommendations."
                        ),
                    },
                    {
                        "role": "user",
                        "content": (
                            "Create an EC2 cost "
                            "optimization executive "
                            "summary from:\n"
                            + json.dumps(
                                context,
                                default=str,
                            )
                        ),
                    },
                ],
            )
        )

        content = (
            response
            .choices[0]
            .message
            .content
            or ""
        )

        provider = "groq"

    row = AISummary(
        summary_type="ec2",
        provider=provider,
        model=settings.llm_model,
        content=content,
        context_json=context,
    )

    db.add(row)
    db.commit()
    db.refresh(row)

    return row


# ============================================================
# RECOMMENDATION AGENT
# ============================================================

def _build_candidate_context(
    candidate: dict[str, Any],
) -> dict[str, Any]:
    """
    Build the grounded evidence sent to the LLM.

    Only fields useful for recommendation reasoning are
    included.

    Ranking and savings remain owned by the deterministic
    pipeline rather than the LLM.
    """

    return {
        # ----------------------------------------------------
        # Resource identity
        # ----------------------------------------------------
        "instance_id": candidate.get(
            "instance_id"
        ),
        "instance_name": candidate.get(
            "instance_name"
        ),
        "instance_type": candidate.get(
            "instance_type"
        ),
        "instance_state": candidate.get(
            "instance_state"
        ),
        "region": candidate.get(
            "region"
        ),
        "account_name": candidate.get(
            "account_name"
        ),

        # ----------------------------------------------------
        # Native SpendSmart optimization
        # ----------------------------------------------------
        "optimization_type": candidate.get(
            "optimization_type"
        ),
        "severity": candidate.get(
            "severity"
        ),
        "top_issue": candidate.get(
            "top_issue"
        ),

        "monthly_cost": candidate.get(
            "monthly_cost"
        ),
        "monthly_savings": candidate.get(
            "monthly_savings"
        ),
        "saving_pct": candidate.get(
            "saving_pct"
        ),

        # ----------------------------------------------------
        # Deterministic validation
        # ----------------------------------------------------
        "validation_status": candidate.get(
            "validation_status"
        ),
        "validation_reasons": candidate.get(
            "validation_reasons"
        ),
        "safety_notes": candidate.get(
            "safety_notes"
        ),

        # ----------------------------------------------------
        # Performance evidence
        # ----------------------------------------------------
        "cpu_avg_pct": candidate.get(
            "cpu_avg_pct"
        ),
        "cpu_p95_pct": candidate.get(
            "cpu_p95_pct"
        ),
        "cpu_max_pct": candidate.get(
            "cpu_max_pct"
        ),

        "net_in_mbps": candidate.get(
            "net_in_mbps"
        ),
        "net_out_mbps": candidate.get(
            "net_out_mbps"
        ),

        "utilization_days": candidate.get(
            "utilization_days"
        ),

        "rightsizing_signal": candidate.get(
            "rightsizing_signal"
        ),

        # ----------------------------------------------------
        # Business / workload context
        # ----------------------------------------------------
        "criticality": candidate.get(
            "criticality"
        ),
        "pricing_model": candidate.get(
            "pricing_model"
        ),

        "is_eks_node": candidate.get(
            "is_eks_node"
        ),
        "eks_cluster": candidate.get(
            "eks_cluster"
        ),
        "eks_nodegroup": candidate.get(
            "eks_nodegroup"
        ),

        "is_asg_member": candidate.get(
            "is_asg_member"
        ),
        "asg_name": candidate.get(
            "asg_name"
        ),

        # ----------------------------------------------------
        # Infrastructure
        # ----------------------------------------------------
        "architecture": candidate.get(
            "architecture"
        ),
        "platform": candidate.get(
            "platform"
        ),

        "has_public_ip": candidate.get(
            "has_public_ip"
        ),

        "attached_ebs_count": candidate.get(
            "attached_ebs_count"
        ),

        "root_volume_type": candidate.get(
            "root_volume_type"
        ),

        "root_volume_size_gb": candidate.get(
            "root_volume_size_gb"
        ),

        # ----------------------------------------------------
        # Optional deterministic target
        # ----------------------------------------------------
        # Currently this will normally be None.
        # If the deterministic pipeline later supplies a target,
        # the validator can permit the LLM to repeat it.
        "recommended_target_instance_type": candidate.get(
            "recommended_target_instance_type"
        ),

        # ----------------------------------------------------
        # Supporting SpendSmart signals
        # ----------------------------------------------------
        "cost_signals": candidate.get(
            "cost_signals"
        ),

        # ----------------------------------------------------
        # Pipeline rank
        # ----------------------------------------------------
        "final_rank": candidate.get(
            "final_rank"
        ),
    }


def _recommendation_system_prompt() -> str:
    """
    System instructions for the EC2 recommendation agent.
    """

    return """
You are the SpendSmart EC2 FinOps Recommendation Agent.

Your responsibility is to explain and operationalize an already-selected
EC2 optimization candidate.

IMPORTANT RULES:

1. Use ONLY the supplied candidate evidence.

2. Never invent:
   - AWS resource information
   - utilization values
   - cost values
   - savings values
   - instance types
   - workload characteristics
   - pricing information

3. Do NOT change:
   - monthly savings
   - savings percentage
   - severity
   - validation status
   - candidate ranking

4. The deterministic SpendSmart pipeline has already selected and
validated the candidate. You are not responsible for selecting candidates.

5. For rightsizing:
   - Consider CPU average, P95, and maximum together.
   - Consider network throughput.
   - Consider criticality.
   - Consider the utilization observation period.
   - Consider the SpendSmart rightsizing signal.

6. If the instance belongs to EKS:
   - Do not recommend resizing the individual EC2 worker directly.
   - Recommend reviewing the EKS node group and its launch template.
   - Mention workload/node capacity validation before rollout.

7. If the instance belongs to an Auto Scaling Group:
   - Recommend reviewing the ASG launch template/configuration rather
     than modifying only the individual instance.

8. Never invent a target EC2 instance type.

9. If the evidence does not contain a recommended target instance type,
state that the target instance type must be determined during engineering
validation.

10. For stopped resources:
    - Never recommend immediate deletion.
    - Recommend validating ownership, attached storage, recovery,
      backup, DR, and business requirements first.

11. For Savings Plan opportunities:
    - Do not interpret low CPU as a reason to reject the recommendation.
    - Focus on usage continuity and commitment suitability.

12. For generation upgrades or architecture changes:
    - Require compatibility testing before migration.

13. Treat safety_notes from the deterministic validation layer as
mandatory constraints.

14. Do not add cost_signals impact_usd to monthly_savings. The native
SpendSmart monthly_savings value remains the canonical savings estimate.

15. Keep the recommendation concise, technical, actionable, and suitable
for a cloud engineering / FinOps team.

16. Every statement in "why" MUST be directly supported by the supplied
candidate evidence.

17. Do not invent infrastructure changes that are not supported by the
candidate evidence. For example, do not recommend:
    - moving resources between public/private subnets
    - changing VPCs
    - changing load balancers
    - changing NAT gateways
    - changing scaling policies
    - changing storage architecture
unless the supplied evidence specifically supports that action.

18. Do not invent organizational requirements such as mandatory tags,
SLA requirements, compliance requirements, maintenance windows, or
business policies.

19. Generic engineering best practices may be included only as
validation steps when directly relevant to the proposed optimization.
Do not present them as facts about the customer's environment.

20. Do not invent a monitoring duration such as 7 days, 14 days,
or 30 days.
If additional monitoring is appropriate, say:
"monitor for an appropriate validation period"
unless a duration exists in the supplied evidence specifically as a
required future validation duration.

The historical utilization observation period is evidence only.
Do not automatically reuse that historical period as a future
monitoring requirement.

21. Memory utilization is not supplied in the current candidate
evidence unless explicitly present.
For rightsizing, treat memory capacity as something that must be
validated before implementation.
Never claim that memory utilization is low unless such evidence
is explicitly supplied.

22. has_public_ip=true is context only.
It does not mean the resource should be moved to a private subnet.

23. Existing ASG or EKS membership determines implementation scope,
but do not claim that scaling policies, health checks, networking,
or Kubernetes configuration require changes unless supported by
the supplied evidence.
They may be validated when directly relevant.

24. Do not claim that mandatory tags are required unless the supplied
candidate evidence explicitly contains that requirement.

25. Do not claim that a test node group exists.
If staged validation is useful, describe it generically as a controlled
or staged validation rather than inventing infrastructure.

26. Do not describe monthly savings or savings percentage as evidence
of workload criticality.
Savings represents financial impact.

27. Risks should describe realistic consequences of the proposed
optimization without claiming that those conditions currently exist.

28. Validation steps may request verification of unknown information,
but they must not claim that the unknown information is already true.

Return ONLY valid JSON.

The JSON must have exactly these keys:

{
  "recommendation_summary": "short explanation",
  "recommended_action": "action to evaluate",
  "implementation_scope": "where the change should be applied",
  "why": [
    "evidence-based reason"
  ],
  "risks": [
    "relevant risk or constraint"
  ],
  "validation_steps": [
    "step before implementation"
  ],
  "target_instance_type": null
}

target_instance_type MUST remain null unless the supplied evidence
explicitly contains recommended_target_instance_type.
""".strip()


# ============================================================
# RECOMMENDATION OUTPUT SCHEMA
# ============================================================

class EC2RecommendationOutput(BaseModel):
    """
    Strict output contract for an EC2 recommendation.

    Unknown fields are rejected so the LLM cannot silently add
    additional recommendation sections.
    """

    model_config = ConfigDict(
        extra="forbid",
        str_strip_whitespace=True,
    )

    recommendation_summary: str = Field(
        min_length=1,
        max_length=500,
    )

    recommended_action: str = Field(
        min_length=1,
        max_length=1000,
    )

    implementation_scope: str = Field(
        min_length=1,
        max_length=500,
    )

    why: list[str] = Field(
        min_length=1,
        max_length=10,
    )

    risks: list[str] = Field(
        min_length=1,
        max_length=10,
    )

    validation_steps: list[str] = Field(
        min_length=1,
        max_length=10,
    )

    target_instance_type: str | None = None


# ============================================================
# DETERMINISTIC GROUNDING VALIDATION
# ============================================================

def _validate_recommendation_grounding(
    recommendation: dict[str, Any],
    context: dict[str, Any],
) -> None:
    """
    Apply deterministic grounding and safety checks after
    Pydantic schema validation.

    The goal is not to judge all LLM semantics.

    Instead, this layer blocks known classes of unsupported
    recommendation behavior before the response reaches the API.
    """

    errors: list[str] = []

    recommendation_text = json.dumps(
        recommendation,
        default=str,
    ).lower()

    action_text = (
        recommendation
        .get(
            "recommended_action",
            "",
        )
        .lower()
    )

    scope_text = (
        recommendation
        .get(
            "implementation_scope",
            "",
        )
        .lower()
    )

    why_text = " ".join(
        recommendation.get(
            "why",
            [],
        )
    ).lower()

    validation_text = " ".join(
        recommendation.get(
            "validation_steps",
            [],
        )
    ).lower()

    # --------------------------------------------------------
    # 1. Target instance type
    # --------------------------------------------------------

    target_instance_type = recommendation.get(
        "target_instance_type"
    )

    supplied_target = context.get(
        "recommended_target_instance_type"
    )

    if (
        target_instance_type is not None
        and not supplied_target
    ):
        errors.append(
            "target_instance_type was invented by the LLM"
        )

    if (
        target_instance_type is not None
        and supplied_target
        and target_instance_type != supplied_target
    ):
        errors.append(
            "target_instance_type does not match "
            "supplied deterministic evidence"
        )

    # --------------------------------------------------------
    # 2. Unsupported infrastructure actions
    # --------------------------------------------------------

    unsupported_action_phrases = [
        "move to a private subnet",
        "move the node group to a private subnet",
        "migrate to a private subnet",
        "move to private subnet",
        "move the instance to a private subnet",
        "change the vpc",
        "migrate to another vpc",
        "migrate to a different vpc",
        "change the load balancer",
        "replace the load balancer",
        "change the nat gateway",
        "update nat gateway",
        "replace the nat gateway",
    ]

    for phrase in unsupported_action_phrases:

        if phrase in recommendation_text:

            errors.append(
                "unsupported infrastructure action: "
                + phrase
            )

    # --------------------------------------------------------
    # 3. Unsupported organizational requirements
    # --------------------------------------------------------
     
    unsupported_policy_phrases = [
        "mandatory tags",
        "required tags",
        "compliance requirement",
        "compliance requirements",
        "maintenance window",
        "maintenance windows",
        "sla requirement",
        "sla requirements",
    ]
    

    for phrase in unsupported_policy_phrases:

        if phrase in recommendation_text:

            errors.append(
                "unsupported organizational requirement: "
                + phrase
            )

    # --------------------------------------------------------
    # 4. Invented future monitoring periods
    # --------------------------------------------------------

    unsupported_monitoring_phrases = [
        "monitor for 7 days",
        "monitor for seven days",
        "monitor for 14 days",
        "monitor for fourteen days",
        "monitor for 30 days",
        "monitor for thirty days",
        "monitor for at least 7 days",
        "monitor for at least seven days",
        "monitor for at least 14 days",
        "monitor for at least fourteen days",
        "monitor for at least 30 days",
        "monitor for at least thirty days",
        "same 30-day",
        "same 30 day",
        "same 7-day",
        "same 7 day",
        "same 14-day",
        "same 14 day",
    ]

    for phrase in unsupported_monitoring_phrases:

        if phrase in validation_text:

            errors.append(
                "unsupported future monitoring duration: "
                + phrase
            )

    # --------------------------------------------------------
    # 5. EKS rightsizing scope
    # --------------------------------------------------------

    if (
        context.get("is_eks_node") is True
        and context.get("optimization_type")
        == "rightsizing"
    ):

        combined_scope = (
            f"{action_text} {scope_text}"
        )

        if (
            "node group" not in combined_scope
            and "nodegroup" not in combined_scope
        ):

            errors.append(
                "EKS rightsizing recommendation does not "
                "reference node-group scope"
            )

    # --------------------------------------------------------
    # 6. ASG rightsizing scope
    # --------------------------------------------------------

    if (
        context.get("is_asg_member") is True
        and context.get("optimization_type")
        == "rightsizing"
    ):

        combined_scope = (
            f"{action_text} {scope_text}"
        )

        if (
            "auto scaling" not in combined_scope
            and "autoscaling" not in combined_scope
            and "asg" not in combined_scope
            and "launch template" not in combined_scope
        ):

            errors.append(
                "ASG rightsizing recommendation does not "
                "reference ASG or launch-template scope"
            )

    # --------------------------------------------------------
    # 7. Protect managed EKS workers
    # --------------------------------------------------------

    if context.get("is_eks_node") is True:

        dangerous_individual_actions = [
            "resize the instance directly",
            "resize this instance directly",
            "resize the ec2 instance directly",
            "modify the instance directly",
            "change this instance directly",
            "change the instance directly",
            "terminate the instance immediately",
            "terminate this instance immediately",
        ]

        for phrase in dangerous_individual_actions:

            if phrase in recommendation_text:

                errors.append(
                    "unsafe EKS individual-instance action: "
                    + phrase
                )

    # --------------------------------------------------------
    # 8. Memory grounding
    # --------------------------------------------------------

    if (
        context.get("optimization_type")
        == "rightsizing"
    ):

        unsupported_memory_claims = [
            "low memory utilization",
            "memory utilization is low",
            "memory is underutilized",
            "memory is under-utilized",
            "low memory usage",
            "memory usage is low",
        ]

        for phrase in unsupported_memory_claims:

            if phrase in recommendation_text:

                errors.append(
                    "memory utilization claim is unsupported"
                )

    # --------------------------------------------------------
    # 9. Public-IP grounding
    # --------------------------------------------------------

    public_ip_action_phrases = [
        "remove the public ip",
        "remove public ip",
        "disable the public ip",
        "disable public ip",
        "replace the public ip",
    ]

    for phrase in public_ip_action_phrases:

        if phrase in recommendation_text:

            errors.append(
                "public-IP action is unsupported by "
                "rightsizing evidence: "
                + phrase
            )

    # --------------------------------------------------------
    # 10. Financial impact must not become criticality evidence
    # --------------------------------------------------------

    criticality_phrases = [
        "validating the criticality",
        "validates the criticality",
        "confirms the criticality",
        "proves the criticality",
    ]

    for phrase in criticality_phrases:

        if phrase in why_text:

            errors.append(
                "financial evidence was incorrectly used "
                "to infer recommendation criticality"
            )

    # --------------------------------------------------------
    # Final decision
    # --------------------------------------------------------

    if errors:

        logger.warning(
            (
                "EC2 recommendation grounding validation "
                "failed | instance_id=%s | errors=%s"
            ),
            context.get(
                "instance_id"
            ),
            errors,
        )

        raise ValueError(
            "LLM recommendation failed grounding "
            "validation: "
            + "; ".join(errors)
        )

    logger.info(
        (
            "EC2 recommendation grounding validation "
            "passed | instance_id=%s"
        ),
        context.get(
            "instance_id"
        ),
    )


# ============================================================
# JSON PARSER + SCHEMA VALIDATION
# ============================================================

def _parse_llm_json(
    content: str,
    context: dict[str, Any],
) -> dict[str, Any]:
    """
    Parse, schema-validate, and grounding-validate the
    recommendation returned by the LLM.
    """

    cleaned = content.strip()

    if cleaned.startswith("```json"):
        cleaned = cleaned[7:]

    elif cleaned.startswith("```"):
        cleaned = cleaned[3:]

    if cleaned.endswith("```"):
        cleaned = cleaned[:-3]

    cleaned = cleaned.strip()

    try:

        parsed = json.loads(
            cleaned
        )

    except json.JSONDecodeError as exc:

        logger.warning(
            (
                "EC2 recommendation JSON parsing failed | "
                "instance_id=%s | error=%s"
            ),
            context.get(
                "instance_id"
            ),
            str(exc),
        )

        raise ValueError(
            "LLM recommendation did not return valid JSON"
        ) from exc

    if not isinstance(
        parsed,
        dict,
    ):

        raise ValueError(
            "LLM recommendation must return a JSON object"
        )

    # --------------------------------------------------------
    # Strict Pydantic schema validation
    # --------------------------------------------------------

    try:

        validated = (
            EC2RecommendationOutput
            .model_validate(
                parsed
            )
        )

    except ValidationError as exc:

        logger.warning(
            (
                "EC2 recommendation schema validation "
                "failed | instance_id=%s | errors=%s"
            ),
            context.get(
                "instance_id"
            ),
            exc.errors(),
        )

        raise ValueError(
            "LLM recommendation failed schema validation"
        ) from exc

    recommendation = (
        validated.model_dump()
    )

    # --------------------------------------------------------
    # Deterministic grounding validation
    # --------------------------------------------------------

    _validate_recommendation_grounding(
        recommendation,
        context,
    )

    return recommendation


# ============================================================
# SINGLE-CANDIDATE RECOMMENDATION
# ============================================================

def generate_candidate_recommendation(
    candidate: dict[str, Any],
) -> dict[str, Any]:
    """
    Generate an LLM recommendation for one already-selected
    EC2 optimization candidate.

    The deterministic candidate fields remain canonical.
    """

    instance_id = candidate.get(
        "instance_id"
    )

    logger.info(
        (
            "Starting EC2 recommendation agent | "
            "instance_id=%s | optimization_type=%s"
        ),
        instance_id,
        candidate.get(
            "optimization_type"
        ),
    )

    context = _build_candidate_context(
        candidate
    )

    # --------------------------------------------------------
    # LLM disabled
    # --------------------------------------------------------

    if not settings.enable_llm:

        logger.info(
            (
                "EC2 recommendation agent skipped | "
                "instance_id=%s | reason=llm_disabled"
            ),
            instance_id,
        )

        return {
            "llm_used": False,
            "llm_provider": "disabled",
            "llm_model": settings.llm_model,
            "recommendation": None,
        }

    # --------------------------------------------------------
    # Provider validation
    # --------------------------------------------------------

    provider = (
        settings.llm_provider
        .strip()
        .lower()
    )

    if provider != "groq":

        raise ValueError(
            (
                "Unsupported LLM provider for EC2 "
                f"recommendation agent: {provider}"
            )
        )

    if not settings.groq_api_key.strip():

        raise ValueError(
            "GROQ_API_KEY is not configured"
        )

    # --------------------------------------------------------
    # Groq
    # --------------------------------------------------------

    from groq import Groq

    client = Groq(
        api_key=(
            settings.groq_api_key.strip()
        )
    )

    logger.info(
        (
            "Calling EC2 recommendation LLM | "
            "instance_id=%s | provider=%s | model=%s"
        ),
        instance_id,
        provider,
        settings.llm_model,
    )

    response = (
        client.chat.completions.create(
            model=settings.llm_model,
            temperature=0.1,
            messages=[
                {
                    "role": "system",
                    "content": (
                        _recommendation_system_prompt()
                    ),
                },
                {
                    "role": "user",
                    "content": (
                        "Generate the EC2 optimization "
                        "recommendation using this "
                        "candidate evidence:\n\n"
                        + json.dumps(
                            context,
                            default=str,
                            indent=2,
                        )
                    ),
                },
            ],
        )
    )

    content = (
        response
        .choices[0]
        .message
        .content
        or ""
    )

    # --------------------------------------------------------
    # Parse + schema validate + grounding validate
    # --------------------------------------------------------

    recommendation = _parse_llm_json(
        content,
        context,
    )

    logger.info(
        (
            "EC2 recommendation agent completed | "
            "instance_id=%s"
        ),
        instance_id,
    )

    return {
        "llm_used": True,
        "llm_provider": provider,
        "llm_model": settings.llm_model,
        "recommendation": recommendation,
    }


# ============================================================
# BATCH RECOMMENDATIONS
# ============================================================

def generate_candidate_recommendations(
    candidates: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    """
    Generate recommendations for the final validated candidate list.

    Candidate order and deterministic ranking are preserved.

    Failure for one candidate does not fail the complete batch.
    """

    logger.info(
        (
            "Starting EC2 recommendation generation | "
            "candidates=%s"
        ),
        len(candidates),
    )

    results: list[dict[str, Any]] = []

    for candidate in candidates:

        item = dict(
            candidate
        )

        try:

            ai_result = (
                generate_candidate_recommendation(
                    candidate
                )
            )

            item.update(
                ai_result
            )

        except Exception as exc:

            logger.exception(
                (
                    "EC2 recommendation generation failed | "
                    "instance_id=%s"
                ),
                candidate.get(
                    "instance_id"
                ),
            )

            item["llm_used"] = False
            item["llm_provider"] = (
                settings.llm_provider
            )
            item["llm_model"] = (
                settings.llm_model
            )
            item["recommendation"] = None

            # For the POC this is useful for debugging.
            # Later we can replace this with a safer public
            # error code before exposing externally.
            item["llm_error"] = str(
                exc
            )

        results.append(
            item
        )

    success_count = sum(
        1
        for item in results
        if item.get(
            "llm_used"
        )
    )

    logger.info(
        (
            "EC2 recommendation generation completed | "
            "input=%s | success=%s | failed=%s"
        ),
        len(candidates),
        success_count,
        len(candidates) - success_count,
    )

    return results